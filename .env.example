# Copiez ces noms dans Vercel (Settings > Environment Variables). Ne mettez jamais de vraie clé secrète dans ce fichier.

# Adresse publique du site
NEXT_PUBLIC_SITE_URL=https://licences-gamma.vercel.app

# Supabase : valeurs publiques par conception (les données sont protégées par la RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Stripe : valeurs privées, uniquement côté serveur
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
